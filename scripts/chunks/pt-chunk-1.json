    "k": "CancellationPolicyPage.accordionCoachTitle",
    "en": "Coach Cancellation Policy"
  },
  {
    "k": "CancellationPolicyPage.accordionCustomerBody",
    "en": "Customers may cancel a booking according to the timing of the cancellation. If a cancellation is made 7 or more days before the scheduled session, the customer may be eligible for a full refund. If the cancellation is made between 48 hours and 7 days before the session, the customer may be eligible for a partial refund. If the cancellation is made less than 48 hours before the session, the booking is generally non-refundable unless the coach or PeakUp approves an exception."
  },
  {
    "k": "CancellationPolicyPage.accordionCustomerTitle",
    "en": "Customer Cancellation Policy"
  },
  {
    "k": "CancellationPolicyPage.accordionForceMajeureBody",
    "en": "Exceptional events outside the control of the customer, coach or PeakUp may be reviewed individually. These may include serious illness, injury, natural events, travel disruption, resort closures, official restrictions, or other extraordinary circumstances."
  },
  {
    "k": "CancellationPolicyPage.accordionForceMajeureTitle",
    "en": "Force Majeure"
  },
  {
    "k": "CancellationPolicyPage.accordionNoShowBody",
    "en": "If a customer does not attend a confirmed session without prior notice, the booking is generally considered non-refundable. If a coach does not attend a confirmed session without valid reason or communication, PeakUp may review the case and take appropriate action."
  },
  {
    "k": "CancellationPolicyPage.accordionNoShowTitle",
    "en": "No-show Policy"
  },
  {
    "k": "CancellationPolicyPage.accordionRefundsBody",
    "en": "Refunds and payouts depend on the timing and reason for the cancellation. PeakUp may withhold, adjust or release payouts depending on the applicable cancellation rule, customer refund eligibility, and the specific circumstances of the case."
  },
  {
    "k": "CancellationPolicyPage.accordionRefundsTitle",
    "en": "Refunds and Payouts"
  },
  {
    "k": "CancellationPolicyPage.accordionReschedulingBody",
    "en": "PeakUp encourages rescheduling before cancellation whenever possible. If both the customer and coach agree on a new date or time, the booking may be moved without requiring a refund. Rescheduling is especially encouraged for weather-related or operational reasons."
  },
  {
    "k": "CancellationPolicyPage.accordionReschedulingTitle",
    "en": "Rescheduling"
  },
  {
    "k": "CancellationPolicyPage.accordionReviewBody",
    "en": "PeakUp reserves the right to review cancellation cases individually, especially when safety, fairness, repeated cancellations, disputes, or platform quality are involved."
  },
  {
    "k": "CancellationPolicyPage.accordionReviewTitle",
    "en": "PeakUp Review Rights"
  },
  {
    "k": "CancellationPolicyPage.accordionWeatherTitle",
    "en": "Weather and Safety"
  },
  {
    "k": "CancellationPolicyPage.disclaimer",
    "en": "This policy may be updated from time to time. The applicable policy is the version published on PeakUp at the time of booking, unless otherwise required by law."
  },
